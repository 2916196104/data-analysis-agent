# 第二阶段：将此文件复制为 .env，并填写 OpenAI 兼容服务
# 支持原生函数调用。绝不要提交 .env 或真实密钥。
# SiliconFlow 中国区：https://api.siliconflow.cn/v1
# SiliconFlow 全球区：https://api.siliconflow.com/v1
# 从同一平台账号的模型库复制准确的模型 ID。
LLM_MODEL_ID=
LLM_API_KEY=
LLM_BASE_URL=

# 每次分析允许的最大模型轮数和工具调用总数
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=12
# 每次请求的网络超时；重试次数用于销售 Agent 和标注恢复轮，标注首轮固定为 0
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
# 回答解释独立预算；不改变工具规划的超时和调用上限。
ANSWER_INPUT_MAX_BYTES=16000
ANSWER_TIMEOUT_SECONDS=15
ANSWER_MAX_RETRIES=0

# 可选的 PostgreSQL 存储。使用 --db env:DATABASE_URL 显式选择。
# 保留现有 LLM 设置。密码中的特殊字符请进行百分号编码。
# 示例：postgresql://review_agent:URL_ENCODED_PASSWORD@127.0.0.1:5432/reviews
DATABASE_URL=

# PostgreSQL SQL 调试日志：1 开启，0 关闭；只打印语句模板和耗时，不打印参数值。
# IDEA 的前后端启动配置默认设为 1，运行配置中的环境变量优先于此文件。
DATABASE_SQL_LOG=0

# 持久评论标注：先执行 review-label queue init，再改为 redis。
# redis 模式下，原 run/API 标注入口只提交并等待专用 Worker，不自行调用模型。
LABEL_EXECUTION_MODE=local
LABEL_REDIS_URL=redis://127.0.0.1:6379/0
# 同一供应商账户/共享配额的所有 Worker 使用相同的非敏感标识、Redis 和配置。
LABEL_QUOTA_SCOPE=
# 必填：根据账户真实额度配置；此处不提供猜测额度。
LABEL_RPM=
LABEL_TPM=
# 三个独立参数：数据库领取条数、每请求评论数、所有 Worker 合计并发请求数。
LABEL_DB_CHUNK_SIZE=100
LABEL_BATCH_SIZE=4
LABEL_MAX_CONCURRENCY=2
LABEL_MAX_CALLS_PER_REVIEW=6
LABEL_MAX_RETRIES=2
LABEL_BACKOFF_SECONDS=10
LABEL_LEASE_SECONDS=120
LABEL_STREAM=review-labels
LABEL_GROUP=label-workers
# 原 CLI/API 等待专用 Worker 的最长秒数；到时返回 run_id，后台持久任务保留。
LABEL_COORDINATOR_TIMEOUT_SECONDS=3600
