# Phase 2: copy this file to .env and fill in an OpenAI-compatible service
# supporting native function calling. Never commit .env or real keys.
# SiliconFlow China: https://api.siliconflow.cn/v1
# SiliconFlow global: https://api.siliconflow.com/v1
# Copy the exact model ID from the same platform account's Model Library.
LLM_MODEL_ID=
LLM_API_KEY=
LLM_BASE_URL=

# Maximum model rounds and total tool calls per analysis
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=12
# Per-request network timeout and additional retries for transient errors
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
