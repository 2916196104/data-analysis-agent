{
  "$defs": {
    "FactJudgment": {
      "additionalProperties": false,
      "properties": {
        "fact_id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Fact Id",
          "type": "string"
        },
        "key": {
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Key",
          "type": "string"
        },
        "status": {
          "enum": [
            "supported",
            "refuted",
            "not_supported",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "support_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Span"
          },
          "title": "Support Refs",
          "type": "array"
        },
        "refutation_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Span"
          },
          "title": "Refutation Refs",
          "type": "array"
        },
        "context_veto_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Span"
          },
          "title": "Context Veto Refs",
          "type": "array"
        },
        "reason_code": {
          "enum": [
            "direct_report",
            "explicit_refutation",
            "context_veto",
            "no_direct_support",
            "semantics_unknown",
            "conflicting_evidence"
          ],
          "title": "Reason Code",
          "type": "string"
        },
        "rationale": {
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "fact_id",
        "key",
        "status",
        "reason_code",
        "rationale"
      ],
      "title": "FactJudgment",
      "type": "object"
    },
    "RelationJudgment": {
      "additionalProperties": false,
      "properties": {
        "relation_id": {
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Relation Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "supported",
            "refuted",
            "not_supported",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "witnesses": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Witness"
          },
          "title": "Witnesses",
          "type": "array"
        },
        "support_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Span"
          },
          "title": "Support Refs",
          "type": "array"
        },
        "refutation_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Span"
          },
          "title": "Refutation Refs",
          "type": "array"
        },
        "reason_code": {
          "enum": [
            "relation_verified",
            "relation_unknown",
            "conflicting_evidence"
          ],
          "title": "Reason Code",
          "type": "string"
        },
        "rationale": {
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "relation_id",
        "status",
        "reason_code",
        "rationale"
      ],
      "title": "RelationJudgment",
      "type": "object"
    },
    "Span": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Key",
          "type": "string"
        },
        "source_identity_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Identity Sha256",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "text": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "key",
        "source_identity_sha256",
        "start",
        "end",
        "text"
      ],
      "title": "Span",
      "type": "object"
    },
    "Witness": {
      "additionalProperties": false,
      "properties": {
        "fact_id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Fact Id",
          "type": "string"
        },
        "key": {
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Key",
          "type": "string"
        }
      },
      "required": [
        "fact_id",
        "key"
      ],
      "title": "Witness",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "p5b-evidence-output-draft-v1",
      "default": "p5b-evidence-output-draft-v1",
      "title": "Version",
      "type": "string"
    },
    "request_id": {
      "maxLength": 1000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Request Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "execution_status": {
      "enum": [
        "completed",
        "failed"
      ],
      "title": "Execution Status",
      "type": "string"
    },
    "fact_judgments": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FactJudgment"
      },
      "title": "Fact Judgments",
      "type": "array"
    },
    "relation_judgments": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RelationJudgment"
      },
      "title": "Relation Judgments",
      "type": "array"
    }
  },
  "required": [
    "request_id",
    "input_sha256",
    "execution_status"
  ],
  "title": "JudgeOutput",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:data-analysis-agent:p5b1:model_output:draft-v1"
}
